FROM python:3.12-slim

WORKDIR /app

# Install dependencies
# We must copy both files because requirements.api.txt references requirements.min.txt
COPY requirements.min.txt requirements.api.txt ./
RUN pip install --no-cache-dir -r requirements.api.txt

# Copy source code
COPY . .

# Unbuffered output ensures we see the Agent's thought process in docker logs instantly
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
