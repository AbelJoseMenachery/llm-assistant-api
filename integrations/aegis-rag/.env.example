# ==========================================
# Aegis Omnisearch Agent Configuration
# ==========================================

# --- API & Services ---
API_URL=http://127.0.0.1:8000

CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- LLM Configuration (Gemini) ---
# Specify which Gemini model to use.
GEMINI_MODEL=gemini-3.6-flash

# (Optional) Set your API key here for local CLI testing.
# For UI usage, the Streamlit sidebar will request the key dynamically (BYOK).
GEMINI_API_KEY=

# --- MLOps: Artifact Pipeline ---
# Secret used to validate GitHub Webhook signatures (prevent unauthorized updates)
GITHUB_WEBHOOK_SECRET=your_super_secret_webhook_key
# GitHub Token (Classic or Fine-Grained) to download release assets (prevents rate limits)
GITHUB_TOKEN=your_github_personal_access_token
# The repository to fetch initial artifacts from on first deployment (e.g., yourusername/aegis)
GITHUB_REPO=yourusername/aegis
